---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { LocalVendorConnectFlow } from '../components/react/LocalVendorConnectFlow.tsx';
---

<DashboardLayout 
  title="Local Vendor Connect" 
  activeNav="local-vendor-connect"
  statusBadge="ONBOARDING"
>
  <div class="space-y-6">
    <div class="mb-4">
      <h1 class="text-3xl font-bold tracking-tight">Local Vendor Connect</h1>
      <p class="text-neutral-400 mt-2">Automated vendor onboarding & cash transaction capture system.</p>
    </div>

    <!-- Multi-step Onboarding Flow -->
    <LocalVendorConnectFlow client:load />
    
  </div>
</DashboardLayout>
