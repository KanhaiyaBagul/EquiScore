---
<header class="sticky top-0 z-50 bg-[#000000]/85 backdrop-blur-md border-b border-[#222222]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-white flex items-center justify-center font-bold text-black text-lg transition-transform group-hover:scale-105 shadow-white-glow">
        ✦
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-xl font-extrabold tracking-tight text-white font-sans">Equi<span class="text-neutral-400">Score</span></span>
        <span class="text-[10px] tracking-wider uppercase font-semibold text-white px-2 py-0.5 rounded-full bg-white/10 border border-white/20">XAI</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-text-secondary">
      <a href="/upload" class="hover:text-white transition-colors">Upload Data</a>
      <a href="/dashboard" class="hover:text-white transition-colors">Live Dashboard</a>
      <a href="/simulator" class="hover:text-white transition-colors">What-If Sandbox</a>
      <a href="/fairness" class="hover:text-white transition-colors">Fairness Audit</a>
      <a href="/passport" class="hover:text-white transition-colors">Digital Passport</a>
    </nav>

    <!-- Action Buttons -->
    <div class="flex items-center gap-3">
      <a href="/upload" class="hidden sm:inline-flex btn-dark text-xs py-2 px-4">
        Upload Statement
      </a>
      <a href="/dashboard" class="btn-white text-xs py-2 px-4">
        <span>+</span> Open Live Dashboard
      </a>
    </div>
  </div>
</header>
